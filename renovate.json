{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "enabledManagers": [
    "npm",
    "pep621",
    "dockerfile",
    "github-actions",
    "devcontainer",
    "custom.regex"
  ],
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/.venv/**",
    ".superpowers/**",
    "reports/**",
    ".github/workflows/*.lock.yml",
    ".claude/skills/**",
    ".claude/lsp/**"
  ],
  "minimumReleaseAge": "14 days",
  "minimumReleaseAgeBehaviour": "timestamp-required",
  "internalChecksFilter": "strict",
  "customManagers": [
    {
      "customType": "regex",
      "description": "Tagged GitHub marketplace sources in the Claude settings, including plugin-prefixed tags",
      "managerFilePatterns": [
        "/^\\.claude/settings\\.json$/"
      ],
      "matchStrings": [
        "\"repo\"\\s*:\\s*\"(?<depName>[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+)\"\\s*,\\s*\"ref\"\\s*:\\s*\"(?<currentValue>(?:[A-Za-z0-9._-]+-)?v?\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?)\""
      ],
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "regex:^(?<compatibility>(?:[A-Za-z0-9._-]+-)?)v?(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)(?:-(?<prerelease>[0-9A-Za-z.-]+))?$"
    }
  ],
  "packageRules": [
    {
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    },
    {
      "matchPackageNames": [
        "nautilus-trader",
        "alpaca-py"
      ],
      "enabled": false
    }
  ]
}
